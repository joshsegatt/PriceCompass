{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [],
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE_URL": "https://your-backend.onrender.com"
